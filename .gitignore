# ==============================================================================
# Java & Maven Artifacts
# ==============================================================================
target/
build/
*.releaseBackup
.mvn/wrapper/maven-wrapper.jar

# Configuration & Secrets
*.properties
!.mvn/wrapper/maven-wrapper.properties
.env
.env.*

# ==============================================================================
# Terraform & Infrastructure as Code (IaC)
# ==============================================================================
# Ignore local provider caches and modules across all subdirectories
**/.terraform/
.terraform/

# State files & logs
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log

# Variable definition files containing potential secrets
*.tfvars
*.tfvars.json
!*.tfvars.example

# Local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# ==============================================================================
# Secrets, Private Keys & Certificates
# ==============================================================================
*.pem
*.key
*.crt
*.p12
*.jks

# ==============================================================================
# IDEs & Developer Environment Noise
# ==============================================================================
.idea/
*.iml
.settings/
.classpath
.project
.vscode/
*.swp
*.swo

# OS Noise
.DS_Store
Thumbs.db